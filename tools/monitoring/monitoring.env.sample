# Configuration du monitoring PowerView.
# Copier vers /srv/powerview/.monitoring.env (jamais committé) et remplir.

# Serveur et topic ntfy pour les notifications push (Mac / mobile).
# Le topic fait office de secret : utiliser un nom long et aléatoire.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=powerview-adecwatts-XXXXXXXXXXXXXXXXXXXXXXXX

# URL de ping healthchecks.io (dead-man switch).
# Créer un check sur https://healthchecks.io (période 5 min, grâce 10 min)
# et coller son URL de ping ici. Laisser vide pour désactiver.
HEALTHCHECKS_PING_URL=
